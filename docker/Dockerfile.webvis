# Web layer: the controller dependencies (requirements.txt, same as docker/Dockerfile)
# plus the FastAPI backend that serves the frontend and starts/stops main.py.
FROM python:3.12-slim

LABEL maintainer="marcos-pereira"
LABEL description="Web UI to set the trajectory parameters and start/stop the CoppeliaSim controller"

WORKDIR /workspace

# Dependencies are baked in; python_scripts/ and webvis/ are mounted at runtime
COPY requirements.txt /tmp/requirements.txt
COPY webvis/backend/requirements.txt /tmp/requirements-webvis.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r /tmp/requirements.txt -r /tmp/requirements-webvis.txt

ENV SCRIPTS_DIR=/workspace/python_scripts \
    FRONTEND_DIR=/workspace/webvis/frontend \
    PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["uvicorn", "server:app", "--app-dir", "/workspace/webvis/backend", "--host", "0.0.0.0", "--port", "8000"]
